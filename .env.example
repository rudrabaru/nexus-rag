# Copy to .env and fill in. Never commit .env.
# Every variable below is read by src/config.py, which fails fast at startup
# when a required one is missing.

# ── Auth (required) ──────────────────────────────────────────────────────────
# Admin credential, sent as the RAG-API-KEY header on /admin routes.
# Tenant keys are issued by POST /admin/keys and stored only as SHA-256 hashes.
ADMIN_API_KEY=
# Legacy name for ADMIN_API_KEY. Only used as a fallback.
# RAG_API_KEY=

# ── Database (required) ──────────────────────────────────────────────────────
# Neon Postgres, DIRECT endpoint (host without "-pooler"). The pooler is PgBouncer
# in transaction mode, which breaks LISTEN/NOTIFY and advisory locks.
# Format: postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
# Apply the schema once per database: alembic upgrade head
DATABASE_URL=
DB_POOL_SIZE=5

# Integration tests only. Prefer a separate Neon branch. The tests migrate into a
# throwaway schema, pin Alembic's version table to it, refuse to run unless every
# table exists there, and truncate only schema-qualified names, so `public` is
# never touched (verified against a populated database with a before/after checksum).
# TEST_DATABASE_URL=

# ── Legacy migration only (python -m scripts.migrate_legacy) ─────────────────
# QDRANT_URL=
# QDRANT_API_KEY=
# QDRANT_COLLECTION_NAME=nexus_rag_collection

# ── Model providers ──────────────────────────────────────────────────────────
# JINA_API_KEY is required (embeddings). The key for LLM_PROVIDER is required.
JINA_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

LLM_PROVIDER=gemini
# Chat / synthesis model. Leave empty for the provider default.
LLM_MODEL_NAME=
# Vision-OCR model used for scanned PDFs. Independent of LLM_MODEL_NAME.
VISION_MODEL_NAME=

# ── Behaviour ────────────────────────────────────────────────────────────────
ENABLE_RERANKER=true
ENABLE_QUERY_GENERALISATION=false
QUERY_CONCURRENCY=4
# How many ingestion jobs one worker process runs at once (src/jobs/worker.py). Read only
# by the worker; the API never runs jobs, so it has no concurrency setting of its own.
WORKER_CONCURRENCY=2

# ── Network ──────────────────────────────────────────────────────────────────
# Comma-separated browser origins allowed to call the API. Empty = none.
# The Streamlit UI calls the API server-side and needs no CORS entry.
ALLOWED_ORIGINS=
# Set true only when a trusted reverse proxy overwrites X-Forwarded-For.
TRUST_PROXIES=false

# ── Local artifacts ──────────────────────────────────────────────────────────
# OBSERVABILITY_DIR=observability

# ── Streamlit UI only ────────────────────────────────────────────────────────
# API_BASE_URL=http://127.0.0.1:8000
