# Copy to .env and fill in. Never commit .env.
# Every variable below is read by src/config.py, which fails fast at startup
# when a required one is missing.

# ── Auth (required) ──────────────────────────────────────────────────────────
# Admin credential, sent as the RAG-API-KEY header on /admin routes.
# Tenant keys are issued by POST /admin/keys and stored only as SHA-256 hashes.
ADMIN_API_KEY=
# Legacy name for ADMIN_API_KEY. Only used as a fallback.
# RAG_API_KEY=

# ── Database (required) ──────────────────────────────────────────────────────
# Neon Postgres, DIRECT endpoint (host without "-pooler"). The pooler is PgBouncer
# in transaction mode, which breaks LISTEN/NOTIFY and advisory locks.
# Format: postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
# Apply the schema once per database: alembic upgrade head
DATABASE_URL=
DB_POOL_SIZE=5

# Integration tests only. Prefer a separate Neon branch. The tests migrate into a
# throwaway schema, pin Alembic's version table to it, refuse to run unless every
# table exists there, and truncate only schema-qualified names, so `public` is
# never touched (verified against a populated database with a before/after checksum).
# TEST_DATABASE_URL=

# ── Embeddings ───────────────────────────────────────────────────────────────
# One index = one embedding model (provider:model). Ingestion writes to, and queries read
# from, the index of the provider below. voyage (hosted, default) | ollama (local) | jina
# (legacy: only to keep querying the prototype jina-embeddings-v3 index).
EMBEDDING_PROVIDER=voyage
# Empty = provider default (voyage-4, bge-m3, jina-embeddings-v3). Must output 1024 dimensions.
EMBEDDING_MODEL=
# Required when EMBEDDING_PROVIDER=voyage. 200M free tokens per model.
VOYAGE_API_KEY=
# VOYAGE_BASE_URL=https://api.voyageai.com/v1   (MongoDB Atlas keys: https://ai.mongodb.com/v1)
# Without a payment method on the Voyage account the limits are 3 requests and 10K tokens per
# minute; requests are paced to these. Raise them if you add a payment method.
VOYAGE_RPM=3
VOYAGE_TPM=10000
# OLLAMA_BASE_URL=http://localhost:11434

# ── Generation ───────────────────────────────────────────────────────────────
# The key for LLM_PROVIDER is required.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
# RERANKER=jina and the legacy embedding index only. Page fetching is keyless.
JINA_API_KEY=

LLM_PROVIDER=gemini
# Chat / synthesis model. Leave empty for the provider default.
LLM_MODEL_NAME=

# ── Web fetching (fetch worker) ──────────────────────────────────────────────
# Pages are read through hosted reader APIs only: keyless Jina Reader, then Firecrawl if a
# key is set. No process we host contacts the target site.
FIRECRAWL_API_KEY=
# Non-empty = only these domains (and their subdomains) may be fetched, e.g. for a public demo.
FETCH_ALLOWED_DOMAINS=
# Never fetched. Default: major social networks and people-search sites.
# FETCH_DENIED_DOMAINS=facebook.com,instagram.com,x.com,twitter.com,tiktok.com,linkedin.com,whitepages.com,spokeo.com,beenverified.com,truepeoplesearch.com
FETCH_DAILY_PAGE_QUOTA=200
FETCH_MIN_INTERVAL_SECONDS=3

# ── Document parsing (parse worker) ──────────────────────────────────────────
# PDFs longer than this are read as plain text (no headings) instead of with Docling.
DOCLING_MAX_PAGES=50
DOCLING_TIMEOUT_SECONDS=900

# ── Behaviour ────────────────────────────────────────────────────────────────
# Chat's default retrieval. An evaluation (python -m src.retrieving.eval_runner) sets its own.
RETRIEVAL_STRATEGY=hybrid
# The reranker a query's use_reranker flag applies: flashrank (local, $0) | jina (needs
# JINA_API_KEY; one-time grant) | none. Replaces ENABLE_RERANKER.
RERANKER=flashrank
# ms-marco-TinyBERT-L-2-v2 (fast, default) or ms-marco-MiniLM-L-12-v2 (~20x slower on CPU).
# FLASHRANK_MODEL=ms-marco-TinyBERT-L-2-v2
# FLASHRANK_CACHE_DIR=   (default ~/.cache/flashrank; the API image uses /opt/flashrank)
ENABLE_QUERY_GENERALISATION=false
QUERY_CONCURRENCY=4
# How many ingest jobs one parse worker runs at once (src/jobs/worker.py). Docling still parses
# one document at a time per process. The fetch worker always runs one job at a time.
WORKER_CONCURRENCY=2

# ── Network ──────────────────────────────────────────────────────────────────
# Comma-separated browser origins allowed to call the API. Empty = none.
# The Streamlit UI calls the API server-side and needs no CORS entry.
ALLOWED_ORIGINS=
# Set true only when a trusted reverse proxy overwrites X-Forwarded-For.
TRUST_PROXIES=false

# ── Local artifacts ──────────────────────────────────────────────────────────
# OBSERVABILITY_DIR=observability

# ── Streamlit UI only ────────────────────────────────────────────────────────
# API_BASE_URL=http://127.0.0.1:8000
