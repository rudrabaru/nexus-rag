# Copy to .env and fill in. Never commit .env.
# Every variable below is read by src/config.py. A process refuses to start, and names each problem,
# when something it needs is missing or invalid (src/config_checks.py). Variables that no longer
# exist (RAG_API_KEY, ENABLE_RERANKER, TRUST_PROXIES, MISTRAL_API_KEY) also stop it: remove them.

# ── Auth (required by the API) ───────────────────────────────────────────────
# Admin credential, sent as the X-Admin-Key header on /v1/admin routes. At least 32 characters:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Tenant keys are issued by POST /v1/admin/keys and stored only as SHA-256 hashes.
ADMIN_API_KEY=

# ── Database (required) ──────────────────────────────────────────────────────
# Neon Postgres, DIRECT endpoint (host without "-pooler"). The pooler is PgBouncer
# in transaction mode, which breaks LISTEN/NOTIFY and advisory locks.
# A remote database must use TLS: keep ?sslmode=require.
# Format: postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
# Apply the schema once per database: alembic upgrade head
DATABASE_URL=
DB_POOL_SIZE=5

# Integration tests only. Prefer a separate Neon branch. The tests migrate into a
# throwaway schema, pin Alembic's version table to it, refuse to run unless every
# table exists there, and truncate only schema-qualified names, so `public` is
# never touched (verified against a populated database with a before/after checksum).
# TEST_DATABASE_URL=

# ── Embeddings ───────────────────────────────────────────────────────────────
# One index = one embedding model (provider:model). Ingestion writes to, and queries read
# from, the index of the provider below. voyage (hosted, default) | ollama (local).
EMBEDDING_PROVIDER=voyage
# Empty = provider default (voyage-4, bge-m3). Must output 1024 dimensions.
EMBEDDING_MODEL=
# Required when EMBEDDING_PROVIDER=voyage. 200M free tokens per model.
VOYAGE_API_KEY=
# VOYAGE_BASE_URL=https://api.voyageai.com/v1   (MongoDB Atlas keys: https://ai.mongodb.com/v1)
# Without a payment method on the Voyage account the limits are 3 requests and 10K tokens per
# minute (the token limit binds: about 17 chunks a minute); requests are paced to these.
# Raise them if you add a payment method.
VOYAGE_RPM=3
VOYAGE_TPM=10000
# VOYAGE_RERANK_MODEL=rerank-3   (RERANKER=voyage; shares VOYAGE_RPM / VOYAGE_TPM, in a bucket separate from embeddings)
# OLLAMA_BASE_URL=http://localhost:11434

# ── Generation ───────────────────────────────────────────────────────────────
# The key for the LLM_CHAT provider is required by the API. Free-tier prompts may be used by the provider
# to improve its models: use public corpora.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
# Only for RERANKER=jina. Page fetching is keyless.
JINA_API_KEY=

# Which model plays which role, as provider/model (providers: gemini, groq, openai).
# The judge should come from a different family than the model it judges.
LLM_CHAT=gemini/gemini-3.5-flash
# Used by chat only, and only when that provider's key is set. Empty disables the fallback.
LLM_CHAT_FALLBACK=groq/openai/gpt-oss-20b
LLM_REWRITE=groq/openai/gpt-oss-20b
LLM_JUDGE=groq/openai/gpt-oss-20b
LLM_TESTSET=gemini/gemini-3.5-flash

# ── Web fetching (fetch worker) ──────────────────────────────────────────────
# Pages are read through hosted reader APIs only: keyless Jina Reader, then Firecrawl if a
# key is set. No process we host contacts the target site.
FIRECRAWL_API_KEY=
# Non-empty = only these domains (and their subdomains) may be fetched, e.g. for a public demo.
FETCH_ALLOWED_DOMAINS=
# Never fetched. Default: major social networks and people-search sites.
# FETCH_DENIED_DOMAINS=facebook.com,instagram.com,x.com,twitter.com,tiktok.com,linkedin.com,whitepages.com,spokeo.com,beenverified.com,truepeoplesearch.com
FETCH_DAILY_PAGE_QUOTA=200
FETCH_MIN_INTERVAL_SECONDS=3

# ── Document parsing (parse worker) ──────────────────────────────────────────
# PDFs longer than this are read as plain text (no headings) instead of with Docling.
DOCLING_MAX_PAGES=50
DOCLING_TIMEOUT_SECONDS=900

# ── Behaviour ────────────────────────────────────────────────────────────────
# Chat's default retrieval. An experiment (python -m src.evaluation) sets its own.
RETRIEVAL_STRATEGY=hybrid
# The reranker a query's use_reranker flag applies: flashrank (local, $0) | jina (needs
# JINA_API_KEY; one-time grant) | voyage (needs VOYAGE_API_KEY; 3 requests a minute card-free, so
# use a small rerank_candidates) | none.
RERANKER=flashrank
# ms-marco-TinyBERT-L-2-v2 (fast, default) or ms-marco-MiniLM-L-12-v2 (~20x slower on CPU).
# FLASHRANK_MODEL=ms-marco-TinyBERT-L-2-v2
# FLASHRANK_CACHE_DIR=   (default ~/.cache/flashrank; the API image uses /opt/flashrank)
ENABLE_QUERY_GENERALISATION=false
QUERY_CONCURRENCY=4
# How many ingest jobs one parse worker runs at once (python -m src.jobs.workers ingest). Docling
# still parses one document at a time per process. The fetch worker always runs one job at a time.
WORKER_CONCURRENCY=2

# ── Network ──────────────────────────────────────────────────────────────────
# Comma-separated browser origins allowed to call the API. Empty = none.
# The Streamlit UI calls the API server-side and needs no CORS entry.
ALLOWED_ORIGINS=
# How many reverse proxies in front of the API append to X-Forwarded-For (Render: 1). 0 = none.
# Only entries added by trusted proxies are believed; anything further left is client-supplied.
TRUSTED_PROXY_HOPS=0

# ── Streamlit UI only ────────────────────────────────────────────────────────
# API_BASE_URL=http://127.0.0.1:8000
