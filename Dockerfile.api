# The slim image: the API, and (same image, different command) the fetch worker. Neither parses
# documents, so no parser is installed (requirements-api.txt; CI checks none is importable).
#
#   API:           default CMD below
#   Fetch worker:  procrastinate --app=src.jobs.fetch_worker.app worker --queues=fetch --concurrency=1
FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements first to leverage Docker's layer cache.
COPY requirements-base.txt requirements-api.txt ./
RUN pip install --no-cache-dir -r requirements-api.txt

# Bake the default reranker's model (~4 MB) into the image, so no query waits for a download.
# Keep the model name in step with FLASHRANK_MODEL's default (src/config.py).
ENV FLASHRANK_CACHE_DIR=/opt/flashrank
RUN python -c "from flashrank import Ranker; Ranker(model_name='ms-marco-TinyBERT-L-2-v2', cache_dir='/opt/flashrank')"

# Copy the application (.dockerignore keeps secrets and local state out).
# alembic.ini and migrations/ are included: the API verifies the schema revision at startup.
COPY . .

EXPOSE 8000

ENV PYTHONIOENCODING=utf-8
# The `procrastinate` console script (fetch worker) does not put the working directory on sys.path.
ENV PYTHONPATH=/app

# Migrations are applied as a release step (`alembic upgrade head`), never on boot.
CMD ["uvicorn", "src.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
